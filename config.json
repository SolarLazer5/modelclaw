{
    "api": {
        "base_url": "https://api-inference.modelscope.cn/v1",
        "api_key": "",
        "model": "deepseek-ai/DeepSeek-V4.1-Flash",
        "temperature": 0.7,
        "max_tokens": 2048,
        "timeout": 30
    },
    "retry": {
        "max_attempts": 5,
        "initial_wait": 1,
        "backoff_multiplier": 2,
        "max_wait": 30
    },
    "storage": {
        "output_dir": "output",
        "default_format": "json",
        "filename_prefix": "result",
        "save_metadata": true
    },
    "memory": {
        "backend": "postgres",
        "db_path": "output/sessions.db",
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "postgres",
            "database": "modelclaw"
        },
        "max_context_tokens": 4000,
        "summary_trigger_tokens": 6000,
        "keep_recent_turns": 4
    },
    "logging": {
        "level": "INFO",
        "log_file": "output/app.log"
    }
}